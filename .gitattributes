# Auto-detect text files and normalize line endings to LF in the repo.
* text=auto eol=lf

# Explicit text types
*.cs text
*.csproj text
*.sln text eol=crlf
*.json text
*.md text
*.yml text
*.yaml text
*.gitignore text
*.gitattributes text

# Binary types (never touch line endings)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.dll binary
*.so binary
